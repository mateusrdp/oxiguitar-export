{
  "interface": "1.16",
  "id": "oxiguitar.export",
  "name": "Audio export",
  "version": "0.4.0",
  "description": "Exports the score's sound as WAV, FLAC, MP3 or Opus (File → Export Audio…), with each format's own choices in the export dialog: bit depth, rate or bitrate.",
  "authors": ["The OxiGuitar contributors"],
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/mateusrdp/oxiguitar-export",
  "replaces": ["oxiguitar.wav"],
  "exporters": [
    { "id": "wav", "name": "WAV Audio", "extension": "wav", "kind": "audio", "options": "wav-options" },
    { "id": "flac", "name": "FLAC Audio", "extension": "flac", "kind": "audio", "options": "flac-options" },
    { "id": "mp3", "name": "MP3 Audio", "extension": "mp3", "kind": "audio", "options": "mp3-options" },
    { "id": "opus", "name": "Opus Audio", "extension": "opus", "kind": "audio", "options": "opus-options" }
  ],
  "ui": "ui/export.slint",
  "views": [
    { "id": "wav-options", "component": "FormatOptions", "place": "export" },
    { "id": "flac-options", "component": "FormatOptions", "place": "export" },
    { "id": "mp3-options", "component": "FormatOptions", "place": "export" },
    { "id": "opus-options", "component": "FormatOptions", "place": "export" }
  ]
}
